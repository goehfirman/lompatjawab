# Vercel KV / Upstash Redis Configuration
# CATATAN: Saat di-deploy ke Vercel, variabel ini OTOMATIS terisi saat Anda
# menghubungkan KV Database di Dashboard Vercel (Storage -> Create Database -> KV -> Connect).
# Anda HANYA perlu mengisinya jika ingin menjalankan serverless functions secara lokal via vercel dev.

KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
KV_URL=
